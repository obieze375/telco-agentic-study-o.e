# Required — Nebius Token Factory API key
NEBIUS_API_KEY=replace-with-your-nebius-api-key

# Tool server
TRACK_A_PORT=7860
DATA_SOURCE=data/Phase_1
DATA_SPLIT=train

# LLM (Nebius defaults)
MODEL_URL=https://api.tokenfactory.nebius.com/v1
MODEL_NAME=Qwen/Qwen3-30B-A3B-Instruct-2507

# Agent run settings
ARCHITECTURE=investigator_decision
MAX_SAMPLES=10
MAX_ITERATIONS=15
SAVE_DIR=/app/results/docker-run
LOG_FILE=/app/results/docker-run.log
